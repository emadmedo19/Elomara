{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "System administrator mapping for secure role-based access control with Super Admin and Assistant Admin tiers",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin"],
          "description": "Administrator tier: Super Admin (owner) or Admin (assistant)"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Account status"
        },
        "addedBy": {
          "type": "string",
          "description": "UID of the Super Admin who granted privileges"
        },
        "notes": {
          "type": "string",
          "description": "Administrative notes"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when admin role was granted"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when admin status was updated"
        }
      },
      "required": ["email", "role", "status"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Audit trail for admin privilege grants, role changes, and revocations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Audit log entry ID"
        },
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete", "suspend", "activate"],
          "description": "Action performed"
        },
        "targetAdminId": {
          "type": "string",
          "description": "Target admin UID"
        },
        "targetEmail": {
          "type": "string",
          "description": "Target admin email"
        },
        "performedBy": {
          "type": "string",
          "description": "Super Admin UID who performed the action"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "details": {
          "type": "string",
          "description": "Action details and reasoning"
        }
      },
      "required": ["id", "action", "targetAdminId", "performedBy", "timestamp"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role and building/apartment link",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Full name of the user"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "owner", "tenant"],
          "description": "User role in the system"
        },
        "buildingId": {
          "type": "string",
          "description": "Associated building ID (optional for global admins)"
        },
        "apartmentId": {
          "type": "string",
          "description": "Associated apartment ID for residents/owners"
        },
        "unitNumber": {
          "type": "string",
          "description": "Unit or apartment number"
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Account status"
        },
        "leaseStartDate": {
          "type": "string",
          "description": "Lease start date for tenants"
        },
        "leaseEndDate": {
          "type": "string",
          "description": "Lease end date for tenants"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "Building": {
      "title": "Building",
      "description": "Residential building or property",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique building ID"
        },
        "name": {
          "type": "string",
          "description": "Building name"
        },
        "address": {
          "type": "string",
          "description": "Building physical address"
        },
        "totalUnits": {
          "type": "number",
          "description": "Total number of apartments/units"
        },
        "balance": {
          "type": "number",
          "description": "Available treasury balance in EGP"
        },
        "monthlyTarget": {
          "type": "number",
          "description": "Monthly dues collection target"
        },
        "reserveFund": {
          "type": "number",
          "description": "Emergency reserve fund amount"
        },
        "managerName": {
          "type": "string",
          "description": "Building manager name"
        },
        "managerPhone": {
          "type": "string",
          "description": "Building manager contact phone"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "name", "address", "totalUnits", "balance"]
    },
    "Apartment": {
      "title": "Apartment",
      "description": "Apartment or residential unit",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique apartment ID"
        },
        "buildingId": {
          "type": "string",
          "description": "Reference to parent building"
        },
        "unitNumber": {
          "type": "string",
          "description": "Unit or apartment label"
        },
        "floor": {
          "type": "number",
          "description": "Floor number"
        },
        "residentName": {
          "type": "string",
          "description": "Current resident or occupant name"
        },
        "residentPhone": {
          "type": "string",
          "description": "Contact phone number"
        },
        "isOwner": {
          "type": "boolean",
          "description": "Whether the resident is the property owner"
        },
        "monthlyFee": {
          "type": "number",
          "description": "Monthly maintenance and service fee"
        },
        "status": {
          "type": "string",
          "enum": ["paid", "overdue", "pending"],
          "description": "Current dues settlement status"
        },
        "overdueMonths": {
          "type": "number",
          "description": "Count of months overdue"
        },
        "lastPaymentDate": {
          "type": "string",
          "description": "Date of latest recorded payment"
        },
        "paidAmount": {
          "type": "number",
          "description": "Total amount paid in current billing cycle"
        },
        "creditBalance": {
          "type": "number",
          "description": "Advance credit or prepaid balance"
        },
        "leaseStartDate": {
          "type": "string",
          "description": "Lease commencement date"
        },
        "leaseEndDate": {
          "type": "string",
          "description": "Lease expiry date"
        }
      },
      "required": ["id", "buildingId", "unitNumber", "monthlyFee", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Dues collection payment transaction",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique payment ID"
        },
        "apartmentId": {
          "type": "string",
          "description": "ID of apartment this payment applies to"
        },
        "buildingId": {
          "type": "string",
          "description": "ID of parent building"
        },
        "unitNumber": {
          "type": "string",
          "description": "Apartment unit number label"
        },
        "residentName": {
          "type": "string",
          "description": "Name of resident who paid"
        },
        "amount": {
          "type": "number",
          "description": "Paid amount in EGP"
        },
        "date": {
          "type": "string",
          "description": "Payment date (YYYY-MM-DD)"
        },
        "month": {
          "type": "string",
          "description": "Billing month (YYYY-MM)"
        },
        "method": {
          "type": "string",
          "description": "Payment method (نقدي، تحويل بنكي، إنستاباي، فودافون كاش، أخرى)"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or remarks"
        },
        "receiptNumber": {
          "type": "string",
          "description": "Official receipt number"
        },
        "recordedAt": {
          "type": "string",
          "description": "Timestamp when recorded"
        },
        "recordedBy": {
          "type": "string",
          "description": "Admin UID who recorded payment"
        }
      },
      "required": ["id", "apartmentId", "buildingId", "unitNumber", "amount", "date", "month", "method"]
    },
    "PaymentAuditLog": {
      "title": "PaymentAuditLog",
      "description": "Audit log for payment changes and cancellations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Audit log entry ID"
        },
        "action": {
          "type": "string",
          "enum": ["create", "update", "delete"],
          "description": "Action performed"
        },
        "paymentId": {
          "type": "string",
          "description": "Target payment ID"
        },
        "apartmentId": {
          "type": "string",
          "description": "Target apartment ID"
        },
        "unitNumber": {
          "type": "string",
          "description": "Target unit number"
        },
        "buildingId": {
          "type": "string",
          "description": "Parent building ID"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "performedBy": {
          "type": "string",
          "description": "Admin UID or email"
        },
        "notes": {
          "type": "string",
          "description": "Reason or details"
        }
      },
      "required": ["id", "action", "paymentId", "apartmentId", "buildingId", "timestamp", "performedBy"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Building operating expense record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique expense ID"
        },
        "buildingId": {
          "type": "string",
          "description": "Building ID"
        },
        "title": {
          "type": "string",
          "description": "Expense title/description"
        },
        "category": {
          "type": "string",
          "description": "Expense category"
        },
        "amount": {
          "type": "number",
          "description": "Expense cost in EGP"
        },
        "date": {
          "type": "string",
          "description": "Expense date (YYYY-MM-DD)"
        },
        "vendor": {
          "type": "string",
          "description": "Service provider or contractor"
        },
        "notes": {
          "type": "string",
          "description": "Additional details"
        },
        "receiptUrl": {
          "type": "string",
          "description": "Invoice or receipt attachment URL"
        },
        "approvedBy": {
          "type": "string",
          "description": "Approving manager name"
        }
      },
      "required": ["id", "buildingId", "title", "category", "amount", "date", "vendor", "approvedBy"]
    },
    "MaintenanceTicket": {
      "title": "MaintenanceTicket",
      "description": "Resident maintenance request",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Ticket ID"
        },
        "buildingId": {
          "type": "string",
          "description": "Building ID"
        },
        "apartmentId": {
          "type": "string",
          "description": "Apartment ID"
        },
        "unitNumber": {
          "type": "string",
          "description": "Unit number"
        },
        "residentName": {
          "type": "string",
          "description": "Resident reporting issue"
        },
        "category": {
          "type": "string",
          "description": "Category (سباكة، كهرباء، مصاعد، نظافة، أمن، أخرى)"
        },
        "title": {
          "type": "string",
          "description": "Issue summary"
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation"
        },
        "date": {
          "type": "string",
          "description": "Report date"
        },
        "urgency": {
          "type": "string",
          "enum": ["عاجل", "متوسط", "عادي"],
          "description": "Urgency level"
        },
        "status": {
          "type": "string",
          "enum": ["جديد", "قيد التنفيذ", "مكتمل"],
          "description": "Resolution status"
        }
      },
      "required": ["id", "buildingId", "unitNumber", "residentName", "category", "title", "urgency", "status"]
    },
    "FacilityBooking": {
      "title": "FacilityBooking",
      "description": "Shared facility reservation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Booking ID"
        },
        "buildingId": {
          "type": "string",
          "description": "Building ID"
        },
        "apartmentId": {
          "type": "string",
          "description": "Apartment ID"
        },
        "facility": {
          "type": "string",
          "description": "Facility name"
        },
        "unitNumber": {
          "type": "string",
          "description": "Unit number"
        },
        "residentName": {
          "type": "string",
          "description": "Resident name"
        },
        "date": {
          "type": "string",
          "description": "Reservation date"
        },
        "timeSlot": {
          "type": "string",
          "description": "Time slot"
        },
        "status": {
          "type": "string",
          "enum": ["مؤكد", "قيد المراجعة", "ملغي"],
          "description": "Booking status"
        }
      },
      "required": ["id", "buildingId", "facility", "unitNumber", "residentName", "date", "timeSlot", "status"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Building community announcement or notice",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Announcement ID"
        },
        "buildingId": {
          "type": "string",
          "description": "Building ID"
        },
        "title": {
          "type": "string",
          "description": "Announcement headline"
        },
        "content": {
          "type": "string",
          "description": "Announcement body"
        },
        "date": {
          "type": "string",
          "description": "Publication date"
        },
        "type": {
          "type": "string",
          "enum": ["urgent", "maintenance", "meeting", "general"],
          "description": "Announcement category"
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional illustration image URL"
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether pinned to board"
        }
      },
      "required": ["id", "title", "content", "date", "type", "pinned"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Health check document",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Status ping"
        },
        "timestamp": {
          "type": "string",
          "description": "Ping timestamp"
        }
      },
      "required": ["status"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "System administrators mapping for RBAC enforcement"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Immutable audit trail of administrator additions, revocations, and role modifications"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered user accounts with role and apartment associations"
    },
    "/buildings/{buildingId}": {
      "schema": "Building",
      "description": "Residential building properties"
    },
    "/apartments/{apartmentId}": {
      "schema": "Apartment",
      "description": "Residential apartments and units"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Dues collection payments"
    },
    "/payment_audit_logs/{logId}": {
      "schema": "PaymentAuditLog",
      "description": "Audit trail for payment actions"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Operating expenses and maintenance bills"
    },
    "/tickets/{ticketId}": {
      "schema": "MaintenanceTicket",
      "description": "Maintenance tickets reported by residents"
    },
    "/bookings/{bookingId}": {
      "schema": "FacilityBooking",
      "description": "Facility reservations and bookings"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Building public notices and announcements"
    },
    "/test/{testId}": {
      "schema": "ConnectionTest",
      "description": "Connection test doc for Firestore health checks"
    }
  }
}
