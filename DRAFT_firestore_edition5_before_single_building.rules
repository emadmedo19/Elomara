rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 1. Global Default Deny Catch-All
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 2. Core Primitives & Helper Functions
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Root Super Admin: Hard-locked to verified primary system owner email ONLY.
    // Cannot be granted, elevated, or spoofed by writing documents to Firestore.
    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'emadmohamedabdella1@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Assistant Admin: Document exists in /admins/{uid}, role is 'admin', status is explicitly 'active'.
    // Possesses FULL operational admin capabilities across all buildings, apartments, residents,
    // payments, expenses, tickets, bookings, and announcements.
    function isAssistantAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active';
    }

    // Any authorized administrator (Super Admin OR active Assistant Admin)
    function isAdmin() {
      return isSuperAdmin() || isAssistantAdmin();
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Approved Resident: Verified email, active status, valid resident role (owner/tenant), linked unit
    function isApprovedResident() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUserData().status == 'active' &&
        currentUserData().role in ['owner', 'tenant'] &&
        currentUserData().apartmentId != null &&
        currentUserData().buildingId != null;
    }

    // Building document existence verification
    function isBuildingValid(bldId) {
      return bldId is string && bldId.size() > 0 &&
        exists(/databases/$(database)/documents/buildings/$(bldId));
    }

    // Relational integrity helper: All fields must be null (unlinked) OR all must exist and match
    function isValidUnitLinkage(bldId, aptId, unitNum) {
      return (bldId == null && aptId == null && unitNum == null) ||
        (
          bldId is string && aptId is string && unitNum is string &&
          isBuildingValid(bldId) &&
          exists(/databases/$(database)/documents/apartments/$(aptId)) &&
          get(/databases/$(database)/documents/apartments/$(aptId)).data.buildingId == bldId &&
          get(/databases/$(database)/documents/apartments/$(aptId)).data.unitNumber == unitNum
        );
    }

    // Coherence of role, status, and unit linkage
    function isStatusRoleCoherent(status, role, bldId, aptId, unitNum) {
      return (status == 'pending' && role == 'unassigned' && bldId == null && aptId == null && unitNum == null) ||
        (status == 'active' && role in ['owner', 'tenant'] && bldId != null && aptId != null && unitNum != null) ||
        (status == 'suspended' && role in ['owner', 'tenant']);
    }

    // Tenant / Owner payment viewing policy:
    // - Owner can view all payment history for their owned apartment.
    // - Tenant can ONLY view payments from the start of their lease/residence forward.
    function isResidentAuthorizedForPayment(paymentData) {
      return isApprovedResident() &&
        currentUserData().apartmentId == paymentData.apartmentId &&
        (
          currentUserData().role == 'owner' ||
          (
            currentUserData().role == 'tenant' &&
            (
              !('leaseStartDate' in currentUserData()) ||
              currentUserData().leaseStartDate == null ||
              paymentData.date >= currentUserData().leaseStartDate
            )
          )
        );
    }

    // -------------------------------------------------------------------------
    // 3. Health Check / Connection Test
    // -------------------------------------------------------------------------
    match /test/{testId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(testId);
    }

    // -------------------------------------------------------------------------
    // 4. Administrators Collection (/admins/{adminId})
    //    Managed EXCLUSIVELY by Super Admin. Assistant Admins have ZERO write access.
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      // Super Admin can read all; an admin can read their own profile to verify role
      allow get: if isSignedIn() && (isSuperAdmin() || request.auth.uid == adminId);
      allow list: if isSuperAdmin();

      // Super Admin can create Assistant Admins. Role must be 'admin' (creating super_admin is forbidden).
      allow create: if isSuperAdmin() && isValidId(adminId) && (
        incoming().uid == adminId &&
        incoming().role == 'admin' &&
        incoming().status in ['active', 'suspended'] &&
        incoming().email is string &&
        incoming().email.size() <= 200 &&
        incoming().addedBy == request.auth.uid &&
        incoming().keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'addedBy', 'notes', 'createdAt', 'updatedAt'])
      );

      // Super Admin can update an Assistant Admin. Root Super Admin cannot be modified or demoted.
      allow update: if isSuperAdmin() && isValidId(adminId) && (
        adminId != request.auth.uid &&
        existing().email != 'emadmohamedabdella1@gmail.com' &&
        incoming().role == 'admin' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'displayName', 'notes', 'updatedAt'])
      );

      // Super Admin can delete an Assistant Admin. Root Super Admin cannot be deleted.
      allow delete: if isSuperAdmin() && isValidId(adminId) && (
        adminId != request.auth.uid &&
        existing().email != 'emadmohamedabdella1@gmail.com'
      );
    }

    // -------------------------------------------------------------------------
    // 5. Admin Audit Logs (/admin_audit_logs/{logId})
    //    Strictly immutable audit trail of administrator account changes (Super Admin only).
    // -------------------------------------------------------------------------
    match /admin_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() && isValidId(logId) && (
        incoming().performedBy == request.auth.uid &&
        incoming().keys().hasAll(['id', 'action', 'targetAdminId', 'targetEmail', 'performedBy', 'timestamp']) &&
        incoming().keys().hasOnly(['id', 'action', 'targetAdminId', 'targetEmail', 'performedBy', 'timestamp', 'details'])
      );
      allow update, delete: if false; // Strict immutability
    }

    // -------------------------------------------------------------------------
    // 6. Account Linking Audit Logs (/account_link_logs/{logId})
    //    Strictly immutable audit trail of resident approvals, unit links, and status changes.
    // -------------------------------------------------------------------------
    match /account_link_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && (
        incoming().performedBy == request.auth.uid &&
        incoming().keys().hasAll(['id', 'action', 'targetUserId', 'targetEmail', 'buildingId', 'apartmentId', 'unitNumber', 'role', 'performedBy', 'timestamp']) &&
        incoming().keys().hasOnly(['id', 'action', 'targetUserId', 'targetEmail', 'buildingId', 'apartmentId', 'unitNumber', 'role', 'performedBy', 'timestamp', 'notes', 'leaseStartDate', 'leaseEndDate'])
      );
      allow update, delete: if false; // Strict immutability
    }

    // -------------------------------------------------------------------------
    // 7. Users and Profiles (/users/{userId})
    //    - Residents self-register as unassigned & pending with email match.
    //    - Full Admins (Super or Assistant) review, link to unit, set role, and activate.
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Creation
      allow create: if isSignedIn() && isValidId(userId) && (
        // Case A: Resident Self-Registration (starts pending, unassigned, unlinked)
        (
          request.auth.uid == userId &&
          request.auth.token.email != null &&
          incoming().uid == request.auth.uid &&
          incoming().email == request.auth.token.email &&
          incoming().role == 'unassigned' &&
          incoming().status == 'pending' &&
          incoming().buildingId == null &&
          incoming().apartmentId == null &&
          incoming().unitNumber == null &&
          incoming().keys().hasAll(['uid', 'email', 'displayName', 'role', 'status']) &&
          incoming().keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'role', 'status', 'buildingId', 'apartmentId', 'unitNumber', 'createdAt'])
        ) ||
        // Case B: Admin direct creation of resident profile (never admin or super_admin!)
        (
          isAdmin() &&
          incoming().uid == userId &&
          incoming().email is string &&
          incoming().role in ['owner', 'tenant', 'unassigned'] &&
          isValidUnitLinkage(incoming().buildingId, incoming().apartmentId, incoming().unitNumber) &&
          isStatusRoleCoherent(incoming().status, incoming().role, incoming().buildingId, incoming().apartmentId, incoming().unitNumber) &&
          incoming().keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'role', 'status', 'buildingId', 'apartmentId', 'unitNumber', 'leaseStartDate', 'leaseEndDate', 'previousTenancies', 'linkedBy', 'linkedAt', 'createdAt', 'updatedAt'])
        )
      );

      // Updates
      allow update: if isSignedIn() && isValidId(userId) && (
        // Case A: Resident self-update of personal details only
        (
          request.auth.uid == userId &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().buildingId == existing().buildingId &&
          incoming().apartmentId == existing().apartmentId &&
          incoming().unitNumber == existing().unitNumber &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'updatedAt'])
        ) ||
        // Case B: Admin linking / role assignment / activation / suspension (role restricted to owner or tenant)
        (
          isAdmin() &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role in ['owner', 'tenant'] && // NEVER admin!
          isValidUnitLinkage(incoming().buildingId, incoming().apartmentId, incoming().unitNumber) &&
          isStatusRoleCoherent(incoming().status, incoming().role, incoming().buildingId, incoming().apartmentId, incoming().unitNumber) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'buildingId', 'apartmentId', 'unitNumber', 'role', 'status',
            'displayName', 'phone', 'leaseStartDate', 'leaseEndDate', 'previousTenancies',
            'linkedBy', 'linkedAt', 'updatedAt'
          ])
        )
      );

      // Deletion: Super Admin only
      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // 8. Buildings (/buildings/{buildingId})
    //    Full Admins manage all buildings. Approved residents view their assigned building.
    // -------------------------------------------------------------------------
    match /buildings/{buildingId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (isApprovedResident() && currentUserData().buildingId == buildingId)
      );
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(buildingId) && (
        incoming().name is string &&
        incoming().name.size() > 0 &&
        incoming().keys().hasAll(['id', 'name', 'address', 'totalUnits', 'balance'])
      );
      allow delete: if isAdmin() && isValidId(buildingId);
    }

    // -------------------------------------------------------------------------
    // 9. Apartments (/apartments/{apartmentId})
    //    Full Admins manage all apartments. Approved residents can ONLY 'get' their own apartment.
    //    Residents are STRICTLY FORBIDDEN from listing all apartments.
    // -------------------------------------------------------------------------
    match /apartments/{apartmentId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (isApprovedResident() && currentUserData().apartmentId == apartmentId)
      );
      allow list: if isAdmin(); // Strictly restricted to Admins!
      allow create: if isAdmin() && isValidId(apartmentId) && (
        isBuildingValid(incoming().buildingId) &&
        incoming().unitNumber is string &&
        incoming().monthlyFee is number &&
        incoming().monthlyFee >= 0 &&
        incoming().keys().hasOnly(['id', 'buildingId', 'unitNumber', 'floor', 'residentName', 'residentPhone', 'isOwner', 'monthlyFee', 'status', 'overdueMonths', 'lastPaymentDate', 'paidAmount', 'creditBalance', 'leaseStartDate', 'leaseEndDate', 'createdAt', 'updatedAt'])
      );
      allow update: if isAdmin() && isValidId(apartmentId) && isBuildingValid(incoming().buildingId);
      allow delete: if isAdmin() && isValidId(apartmentId);
    }

    // -------------------------------------------------------------------------
    // 10. Payments (/payments/{paymentId})
    //     - Full Admins record and correct payments.
    //     - NO HARD DELETIONS: Permanent immutability of recorded payments (allow delete: if false).
    //     - Corrections or cancellations handled via documented update with audit logging.
    //     - Tenant can only view payments occurring within their lease tenancy period.
    // -------------------------------------------------------------------------
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        isResidentAuthorizedForPayment(resource.data)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        isApprovedResident()
      );
      allow create: if isAdmin() && isValidId(paymentId) && (
        incoming().id == paymentId &&
        incoming().amount is number &&
        incoming().amount > 0 &&
        incoming().date is string &&
        exists(/databases/$(database)/documents/apartments/$(incoming().apartmentId)) &&
        get(/databases/$(database)/documents/apartments/$(incoming().apartmentId)).data.buildingId == incoming().buildingId &&
        get(/databases/$(database)/documents/apartments/$(incoming().apartmentId)).data.unitNumber == incoming().unitNumber &&
        incoming().keys().hasAll(['id', 'apartmentId', 'buildingId', 'unitNumber', 'residentName', 'amount', 'date', 'month', 'method', 'recordedAt', 'recordedBy']) &&
        incoming().keys().hasOnly(['id', 'apartmentId', 'buildingId', 'unitNumber', 'residentName', 'amount', 'date', 'month', 'method', 'notes', 'receiptNumber', 'status', 'recordedAt', 'recordedBy', 'cancelledAt', 'cancelledBy', 'cancellationReason', 'correctionNotes'])
      );
      // Updates are constrained to correction/cancellation metadata; core identifiers and amount remain protected
      allow update: if isAdmin() && isValidId(paymentId) && (
        incoming().id == existing().id &&
        incoming().apartmentId == existing().apartmentId &&
        incoming().buildingId == existing().buildingId &&
        incoming().unitNumber == existing().unitNumber &&
        incoming().amount == existing().amount &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'receiptNumber', 'correctionNotes', 'cancelledAt', 'cancelledBy', 'cancellationReason'])
      );
      // Hard deletion is PERMANENTLY FORBIDDEN to protect financial audit trails
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 11. Payment Audit Logs (/payment_audit_logs/{logId})
    //     Strictly immutable audit trail of payment transactions and cancellations.
    // -------------------------------------------------------------------------
    match /payment_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(logId) && (
        incoming().performedBy == request.auth.uid &&
        incoming().keys().hasAll(['id', 'action', 'paymentId', 'apartmentId', 'buildingId', 'timestamp', 'performedBy']) &&
        incoming().keys().hasOnly(['id', 'action', 'paymentId', 'apartmentId', 'unitNumber', 'buildingId', 'timestamp', 'performedBy', 'previousData', 'newData', 'notes'])
      );
      allow update, delete: if false; // Strict immutability
    }

    // -------------------------------------------------------------------------
    // 12. Operating Expenses (/expenses/{expenseId})
    //     - Full Admins manage all operating expenses across all buildings.
    //     - ZERO access for residents.
    //     - Permanent immutability of historical records: no undocumented hard deletion (allow delete: if false).
    // -------------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(expenseId) && (
        incoming().amount is number &&
        incoming().amount > 0 &&
        incoming().title is string &&
        incoming().title.size() > 0 &&
        (incoming().buildingId == null || isBuildingValid(incoming().buildingId)) &&
        incoming().keys().hasAll(['id', 'title', 'category', 'amount', 'date', 'vendor', 'approvedBy']) &&
        incoming().keys().hasOnly(['id', 'buildingId', 'title', 'category', 'amount', 'date', 'vendor', 'notes', 'receiptUrl', 'approvedBy', 'status', 'createdAt', 'cancelledAt', 'cancelledBy', 'cancellationReason'])
      );
      allow update: if isAdmin() && isValidId(expenseId) && (
        incoming().id == existing().id &&
        (incoming().buildingId == null || isBuildingValid(incoming().buildingId)) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'amount', 'date', 'vendor', 'notes', 'receiptUrl', 'status', 'cancelledAt', 'cancelledBy', 'cancellationReason'])
      );
      // Hard deletion is prohibited; expenses are cancelled/voided with reason
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 13. Maintenance Tickets (/tickets/{ticketId})
    //     - Full Admins manage all tickets across all buildings.
    //     - Approved residents file and view tickets for their own apartment only.
    //     - Resident cannot alter status or spoof unit number.
    // -------------------------------------------------------------------------
    match /tickets/{ticketId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (isApprovedResident() && currentUserData().apartmentId == resource.data.apartmentId)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        isApprovedResident()
      );
      allow create: if isSignedIn() && isValidId(ticketId) && (
        isAdmin() ||
        (
          isApprovedResident() &&
          incoming().apartmentId == currentUserData().apartmentId &&
          incoming().buildingId == currentUserData().buildingId &&
          incoming().unitNumber == currentUserData().unitNumber &&
          incoming().status == 'جديد' &&
          incoming().keys().hasOnly(['id', 'buildingId', 'apartmentId', 'unitNumber', 'residentName', 'category', 'title', 'description', 'date', 'urgency', 'status', 'createdAt'])
        )
      );
      allow update: if isSignedIn() && isValidId(ticketId) && (
        isAdmin() ||
        (
          isApprovedResident() &&
          existing().apartmentId == currentUserData().apartmentId &&
          incoming().status == existing().status && // Resident CANNOT alter status
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'urgency', 'date'])
        )
      );
      allow delete: if isAdmin() && isValidId(ticketId);
    }

    // -------------------------------------------------------------------------
    // 14. Facility Bookings (/bookings/{bookingId})
    //     - Full Admins manage all bookings across all buildings.
    //     - Approved residents file and manage their own bookings only.
    // -------------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (isApprovedResident() && currentUserData().apartmentId == resource.data.apartmentId)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        isApprovedResident()
      );
      allow create: if isSignedIn() && isValidId(bookingId) && (
        isAdmin() ||
        (
          isApprovedResident() &&
          incoming().apartmentId == currentUserData().apartmentId &&
          incoming().buildingId == currentUserData().buildingId &&
          incoming().unitNumber == currentUserData().unitNumber &&
          incoming().status == 'قيد المراجعة' &&
          incoming().keys().hasOnly(['id', 'buildingId', 'apartmentId', 'facility', 'unitNumber', 'residentName', 'date', 'timeSlot', 'status', 'createdAt'])
        )
      );
      allow update: if isSignedIn() && isValidId(bookingId) && (
        isAdmin() ||
        (
          isApprovedResident() &&
          existing().apartmentId == currentUserData().apartmentId &&
          incoming().status in ['قيد المراجعة', 'ملغي'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['date', 'timeSlot', 'status', 'facility'])
        )
      );
      allow delete: if isAdmin() && isValidId(bookingId);
    }

    // -------------------------------------------------------------------------
    // 15. Announcements (/announcements/{announcementId})
    //     - Full Admins manage all announcements (general or per building).
    //     - Residents view general announcements or announcements for their building only.
    //     - Residents CANNOT create, update, or delete announcements.
    // -------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        (isApprovedResident() && (resource.data.buildingId == null || resource.data.buildingId == currentUserData().buildingId))
      );
      allow create, update, delete: if isAdmin() && isValidId(announcementId);
    }
  }
}
